# CyberShield Labs .gitignore
# Cybersecurity Education Platform - Docker-based

# =============================================================================
# DOCKER & CONTAINERS
# =============================================================================

# Docker build cache and temporary files
.docker/
docker-compose.override.yml
.dockerignore.local

# Docker volumes and persistent data (keep lab data out of git)
**/volumes/
**/data/
**/mysql-data/
**/postgres-data/

# Container logs and runtime files
*.container.log
docker-*.log

# =============================================================================
# ENVIRONMENT & SECRETS
# =============================================================================

# Environment files (contains sensitive data)
.env
.env.local
.env.*.local
!.env.example

# Secrets and sensitive configuration
secrets/
*.secret
*.key
*.pem
*.p12
*.pfx

# Database dumps and backups
*.sql.backup
*.dump
backups/

# =============================================================================
# CYBERSECURITY TOOLS & ARTIFACTS
# =============================================================================

# Penetration testing artifacts
exploits/output/
scan-results/
*.pcap
*.cap
wordlists/custom/
payloads/custom/

# Metasploit artifacts
.msf4/
*.rc.local

# Nmap output files
*.gnmap
*.xml.nmap

# Hash files and cracked passwords
*.hashes
*.cracked
*.potfile

# =============================================================================
# SYSTEM & TEMPORARY FILES
# =============================================================================

# Operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor and IDE files
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
.idea/
*.swp
*.swo
*~
.vim/

# Temporary files
*.tmp
*.temp
*.cache
.tmp/
temp/

# Log files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =============================================================================
# BUILD & RUNTIME ARTIFACTS
# =============================================================================

# Build outputs
build/
dist/
out/
target/

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage and test artifacts
coverage/
*.lcov
.nyc_output/
test-results/

# =============================================================================
# PACKAGE MANAGERS (if used for tooling)
# =============================================================================

# Node.js (for any web-based tools)
node_modules/
.npm/
.pnpm-debug.log*

# Python (for any automation scripts)
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/
.venv/
pip-log.txt

# =============================================================================
# PROJECT-SPECIFIC EXCLUSIONS
# =============================================================================

# Phase 0 runtime data
phase0-docker/guacamole/data/
phase0-docker/kali-lite/home/
phase0-docker/vulnerable-lite/logs/

# Student work directories (if students save files)
student-work/
submissions/

# Configuration overrides for different environments
config.local.*
docker-compose.prod.yml
docker-compose.dev.yml

# Scripts that might contain local paths or sensitive info
setup.local.sh
config.local.sh

# =============================================================================
# ALLOW IMPORTANT FILES
# =============================================================================

# Ensure important config files are tracked
!docker-compose.yml
!Dockerfile*
!*.example
!requirements/
!scripts/
!README.md
!LICENSE
